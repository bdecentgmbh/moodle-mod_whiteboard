{{!
    @template mod_whiteboard/boards_actions

    The bar above the boards of groups or users: a menu to switch between them and a button to add one.

    Context variables required for this template:
    * urlselect - core/url_select context
    * addbutton - core/single_button context

    Example context (json):
    {
        "urlselect": {
            "id": "url_select_boards",
            "action": "https://example.com/mod/whiteboard/boards.php",
            "formid": "mod_whiteboard_boards_select",
            "sesskey": "sesskey",
            "label": "Boards",
            "options": [
                {"name": "Group boards", "isgroup": false, "value": "https://example.com/mod/whiteboard/boards.php?mode=group", "selected": true},
                {"name": "User boards", "isgroup": false, "value": "https://example.com/mod/whiteboard/boards.php?mode=user"}
            ],
            "disabled": false
        },
        "addbutton": {
            "method": "get",
            "url": "https://example.com/mod/whiteboard/board.php",
            "formid": "single_button_add",
            "id": "single_button_add_button",
            "primary": true,
            "label": "Add a group board"
        }
    }
}}
<div class="container-fluid tertiary-navigation">
    <div class="d-flex flex-wrap">
        {{#urlselect}}
            <div class="navitem">
                {{>core/url_select}}
            </div>
        {{/urlselect}}
        {{#addbutton}}
            <div class="navitem">
                {{>core/single_button}}
            </div>
        {{/addbutton}}
    </div>
</div>
